# ==============================================================================
# CURRÍCULO FÁCIL — MODELO DE VARIÁVEIS DE AMBIENTE (.env.example)
# NUNCA insira chaves reais neste arquivo nem o envie ao repositório com segredos.
# Para deploy na Netlify, cadastre estas variáveis em:
# Site configuration > Environment variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AMBIENTE DA APLICAÇÃO (Frontend & Backend)
# ------------------------------------------------------------------------------
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://seu-site.netlify.app

# ------------------------------------------------------------------------------
# 2. PROVEDOR DE INTELIGÊNCIA ARTIFICIAL (IA)
# Opções para AI_PROVIDER:
# - 'anthropic' (Recomendado para produção - exige chave oficial sk-ant-api03-...)
# - 'gemini' (Google Gemini 2.5 Flash - gratuito/baixo custo via Google AI Studio)
# - 'mock' (Modo de desenvolvimento/testes locais - custo zero e 100% offline)
# ------------------------------------------------------------------------------
AI_PROVIDER=anthropic

# Anthropic Claude (Oficial):
# ATENÇÃO: A chave DEVE iniciar com 'sk-ant-api03-...' (gerada em console.anthropic.com/settings/keys)
# Chaves iniciadas em 'sk-ant-usr-...' são tokens de usuário e serão rejeitadas pela API.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Telemetria Financeira e Unit Economics de IA:
USD_BRL_EXCHANGE_RATE=5.80
ADMIN_METRICS_TOKEN=

# Provedores Alternativos de IA (Opcionais):
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------------------------
# 3. PROVEDOR DE PAGAMENTO (PIX)
# Opções para PAYMENT_GATEWAY: 'pushinpay' (oficial), 'mock' (testes) ou 'none' (desacoplado)
# ------------------------------------------------------------------------------
PAYMENT_GATEWAY=pushinpay

# Integração PushinPay (Pix Transparente R$ 2,99):
PUSHINPAY_API_URL=https://api.pushinpay.com.br/api
PUSHINPAY_TOKEN=
PUSHINPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 4. PERSISTÊNCIA REMOTA EM NUVEM (SERVERLESS / NETLIFY)
# Upstash Redis REST API para persistir ordens, tokens de download e métricas de IA
# ------------------------------------------------------------------------------
KV_REST_API_URL=
KV_REST_API_TOKEN=

